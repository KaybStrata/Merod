# ════════════════════════════════════════════════════════════════════════
#  MEROD — environment variables (copy to .env.local for local dev).
#  NEVER commit real values. In production set these in Vercel / Railway.
#  Provider API keys can ALSO be pasted in the app at /admin/integrations
#  (encrypted in Postgres with MEROD_MASTER_KEY) — env vars are optional.
# ════════════════════════════════════════════════════════════════════════

# ── Core (required) ─────────────────────────────────────────────────────
# dev | sandbox | production
MEROD_ENV=dev
# Postgres connection string. Railway: use ${{Postgres.DATABASE_URL}} (private) for
# Railway services and the PUBLIC url (…rlwy.net) for Vercel.
DATABASE_URL=postgres://merod:merod@localhost:5432/merod
# true/false to force TLS; leave unset for auto-detection
DATABASE_SSL=
# Keep small on serverless (Vercel): 1–3. Worker: 10.
PG_POOL_MAX=10
# Redis for realtime fan-out + BullMQ jobs. Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
# 32-byte key, base64 or 64 hex chars. Encrypts provider secrets, user API keys, TOTP seeds.
# Generate: openssl rand -base64 32     (MUST be identical on Vercel and Railway)
MEROD_MASTER_KEY=
# Signs WebSocket tokens. Generate: openssl rand -base64 32 (identical on Vercel and Railway)
REALTIME_SECRET=
# Public site URL (CSRF origin check)
APP_URL=http://localhost:3000
# Public WebSocket URL of the Railway worker, e.g. wss://merod-worker.up.railway.app/ws
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws
SESSION_DAYS=14

# ── Safety switches ─────────────────────────────────────────────────────
# Seed demo launch tokens (labeled DEMO DATA, paper-only). Use false in production.
MEROD_DEMO_DATA=true
# Leave UNSET/false. When false, seeding forces all real-money flags OFF and the
# admin UI refuses to enable them. Only set true after legal + provider approvals.
MEROD_ALLOW_LIVE_FLAGS=false

# ── Super admin (platform owner) ────────────────────────────────────────
# Comma-separated owner email(s). These emails are RESERVED: signing up with one grants the
# super_admin role (fees, everything an admin can do) ONLY when the setup code below is entered.
SUPER_ADMIN_EMAILS=
# One-time owner setup code (>= 12 chars). Generate: openssl rand -base64 18
SUPER_ADMIN_SETUP_CODE=

# ── First admin account (created by `npm run db:seed` if missing) ──────
ADMIN_EMAIL=
# at least 12 characters; change after first login and enable 2FA
ADMIN_PASSWORD=

# ── AI (Phase 4) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# comma-separated OpenAI model ids offered in the UI
OPENAI_MODELS=gpt-5,gpt-5-mini

# ── Market data & blockchain infra (Phase 2) ───────────────────────────
HELIUS_API_KEY=
BIRDEYE_API_KEY=
ALCHEMY_API_KEY=
COINGECKO_API_KEY=
MASSIVE_API_KEY=
TWELVEDATA_API_KEY=
# Optional private Solana RPC URL (often embeds a key)
SOLANA_RPC_URL=

# ── Wallets (Phase 2) ───────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# ── Crypto execution (Phase 3) ──────────────────────────────────────────
JUPITER_API_KEY=
ZEROX_API_KEY=
SWAPKIT_API_KEY=
PANORA_API_KEY=
CETUS_API_KEY=

# ── Stocks (Phase 5) — start with paper / sandbox ──────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
IBKR_GATEWAY_URL=
IBKR_OAUTH_CONSUMER_KEY=
TRADIER_ACCESS_TOKEN=

# Sandbox-specific overrides: any key above may be suffixed with _SANDBOX
# (e.g. ALPACA_API_KEY_SANDBOX) to use a different value in the sandbox environment.
